NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://hzegkbmgkvwhvtqdkuqr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
GPU_WORKER_URL=https://your-ngrok-url.ngrok.io/generate

# Inngest — required to send events. Missing key = the banner error you saw:
# "We couldn't find an event key to use to send events to Inngest"
# 1) Go to https://app.inngest.com/env/production/manage/keys → copy Event Key + Signing Key
# 2) Vercel → comic + comic-j6p9 → Settings → Environment Variables → add
#    INNGEST_EVENT_KEY (sensitive, production+preview+development)
#    INNGEST_SIGNING_KEY (sensitive, production+preview+development) → Redeploy
# For local dev you can also just run `npx inngest-cli dev` (no cloud key needed)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
