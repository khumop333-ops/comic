# Supabase — get from https://supabase.com/dashboard/project/hzegkbmgkvwhvtqdkuqr/settings/api
# Use LEGACY JWT keys (eyJ...) for Storage; new sb_ keys will fail with Invalid Compact JWS
NEXT_PUBLIC_SUPABASE_URL=https://hzegkbmgkvwhvtqdkuqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key # fallback if not using NEXT_PUBLIC_ prefix

# GPU worker — RunPod / fal.ai / ngrok tunnel to your diffusion model
GPU_WORKER_URL=https://your-worker.example.com/generate

# Inngest — required to send events. Missing key = "We couldn't find an event key..."
# 1) https://app.inngest.com/env/production/manage/keys → copy Event Key + Signing Key
# 2) Vercel → comic + comic-j6p9 → Settings → Environment Variables → add both (sensitive, all envs) → Redeploy
# For local dev: npx inngest-cli dev (no cloud key needed)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional
NEXT_PUBLIC_SITE_URL=https://your-preview.vercel.app
